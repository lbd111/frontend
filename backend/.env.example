# ================== 服务端口 ==================
PORT=3000

# ================== Supabase ==================
# 项目 URL
SUPABASE_URL=https://cumcskaepjofogktmjzz.supabase.co

# 服务角色密钥（service_role key），用于后端绕过 RLS 更新用户资料
# 在 Supabase 后台 Project Settings → API → service_role secret 获取
# 注意：此密钥不能泄露给前端
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# JWT Secret，用于验签前端传来的 access_token
# 在 Supabase 后台 Project Settings → API → JWT Secret 获取
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ================== MySQL ==================
# 跑在 Win10 虚拟机上的 MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mpay
DB_PASSWORD=123456
DB_NAME=mpay

# ================== mpay 码支付 ==================
# mpay 后台「支付 API 配置」里的商户 PID 和商户密钥
MPAY_API_URL=https://mpay.skypw.dpdns.org
MPAY_PID=1000
MPAY_SECRET=04c920938adcf922d30b4386415e4aeb

# mpay 支付成功后异步通知 BJ 后端的地址（必须是公网 HTTPS/HTTP 可访问）
# 需要先给薄后端配一个 cloudflared Tunnel 子域，例如 api.skypw.dpdns.org
MPAY_NOTIFY_URL=https://api.skypw.dpdns.org/api/mpay/notify

# BJ 前端支付成功回跳页
BJ_RETURN_URL=https://skypw.dpdns.org/pages/pay-return.html
